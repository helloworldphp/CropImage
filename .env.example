OSS_ACCESS_KEY_ID=your_key_id
OSS_ACCESS_KEY_SECRET=your_key_secret
OSS_BUCKET_NAME=your-bucket
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_UPLOAD_PATH_PREFIX=crop

# ModelScope Hosted 固定用 stdio（默认，可不设）
MCP_TRANSPORT=stdio

